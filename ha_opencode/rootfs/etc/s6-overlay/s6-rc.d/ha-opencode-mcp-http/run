#!/command/with-contenv bashio
# ==============================================================================
# OpenCode - HTTP MCP server service (always on)
#
# Serves the add-on's full ha-mcp-server on 8927/tcp. The mcp-hub add-on's
# homeassistant forwarder routes /mcp/homeassistant here, so every session on
# the host shares this one process instead of spawning its own. Bearer-token
# authenticated via MCP_HTTP_TOKEN (the mcp_http_token option).
#
# Deliberately never fails the container: when misconfigured the service just
# idles, exactly like the LAN server service.
# ==============================================================================

export HOME="/data"
export XDG_DATA_HOME="/data/.local/share"
export XDG_CONFIG_HOME="/data/.config"
export NPM_CONFIG_PREFIX="/data/.npm-global"
export NODE_OPTIONS="--max-old-space-size=512"

if [ -f /data/.env_vars ]; then
    source /data/.env_vars
fi

if [ -f /data/.env_vars_discovered ]; then
    source /data/.env_vars_discovered
fi

# Keep the Supervisor token process-only. Tools that expect HA_TOKEN receive it
# from the live environment instead of a persisted /data/.env_vars entry.
if [ -n "${SUPERVISOR_TOKEN:-}" ]; then
    export HA_TOKEN="${SUPERVISOR_TOKEN}"
fi

export PATH="/usr/local/bin:/usr/bin:/bin:${PATH}"
export OPENCODE_DISABLE_AUTOUPDATE=true

MCP_HTTP_PORT=8927

MCP_HTTP_TOKEN=$(bashio::config 'mcp_http_token' 2>/dev/null || echo "")
if ! bashio::var.has_value "${MCP_HTTP_TOKEN}"; then
    bashio::log.error "The 8927 MCP server needs a bearer token."
    bashio::log.error "Set 'mcp_http_token' in the add-on Configuration tab (a !secret <key> value works too), then restart."
    exec sleep infinity
fi
# index.js reads process.env.MCP_HTTP_TOKEN: without this export the exec'd
# node never sees the token and exits at startup.
export MCP_HTTP_TOKEN

HOST_PORT=$(bashio::addon.port "${MCP_HTTP_PORT}/tcp" 2>/dev/null || true)
if bashio::var.has_value "${HOST_PORT}"; then
    bashio::log.info "MCP over HTTP: mapping ${MCP_HTTP_PORT}/tcp -> host ${HOST_PORT}"
else
    bashio::log.info "MCP over HTTP listens on container port ${MCP_HTTP_PORT} (sibling add-ons reach it without a host mapping)"
fi
bashio::log.warning "Only map this port on trusted networks. Do not expose it to the internet."
bashio::log.info "Starting full MCP server over HTTP (bearer authenticated)"

exec node /opt/ha-mcp-server/index.js --transport http --port "${MCP_HTTP_PORT}"
