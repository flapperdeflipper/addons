#!/command/with-contenv bashio
# ==============================================================================
# OpenCode - LAN Server Service (always on)
#
# The OpenChamber add-on attaches to this server on 4096/tcp, so it runs
# unconditionally. It refuses to serve without a basic-auth password
# (the server_password option).
# ==============================================================================

export HOME="/data"
export XDG_DATA_HOME="/data/.local/share"
export XDG_CONFIG_HOME="/data/.config"
export NPM_CONFIG_PREFIX="/data/.npm-global"
export NODE_OPTIONS="--max-old-space-size=512"

if [ -f /data/.env_vars ]; then
    source /data/.env_vars
fi

if [ -f /data/.env_vars_discovered ]; then
    source /data/.env_vars_discovered
fi

# Keep the Supervisor token process-only. Tools that expect HA_TOKEN receive it
# from the live environment instead of a persisted /data/.env_vars entry.
if [ -n "${SUPERVISOR_TOKEN:-}" ]; then
    export HA_TOKEN="${SUPERVISOR_TOKEN}"
fi

# Only the certified runtime in this image is on PATH. /data/.npm-global is
# left out on purpose so an OpenCode installed there by an older add-on version
# cannot shadow the build this release was tested against.
export PATH="/usr/local/bin:/usr/bin:/bin:${PATH}"
export OPENCODE_DISABLE_AUTOUPDATE=true

SERVER_PORT=4096

# ==============================================================================
# Basic authentication. OPENCODE_SERVER_PASSWORD is the OpenCode server's own
# mechanism; without it the LAN listener is unauthenticated. Fail closed: a
# mapped port without credentials would expose the full agent API to anyone
# who can reach it. The username defaults to 'opencode' upstream, on both the
# server and every matching client (OpenChamber, opencode attach).
# This stays scoped to this service on purpose: the TUI in the terminal
# service talks to its own loopback server and must not inherit the gate.
# ==============================================================================
SERVER_PASSWORD=$(bashio::config 'server_password' 2>/dev/null || echo "")

if ! bashio::var.has_value "${SERVER_PASSWORD}"; then
    bashio::log.error "The LAN server needs a basic-auth password."
    bashio::log.error "Set 'server_password' in the add-on Configuration tab (a !secret <key> value works too), then restart."
    exec sleep infinity
fi
export OPENCODE_SERVER_PASSWORD="${SERVER_PASSWORD}"
bashio::log.info "LAN server: HTTP basic auth required (default username 'opencode')."

HOST_PORT=$(bashio::addon.port "${SERVER_PORT}/tcp" 2>/dev/null || true)

bashio::log.info "LAN server config: INTERNAL_PORT=${SERVER_PORT} HOST_PORT=${HOST_PORT:-unmapped}"
if bashio::var.has_value "${HOST_PORT}"; then
    bashio::log.info "Home Assistant port mapping: ${SERVER_PORT}/tcp -> ${HOST_PORT}"
    bashio::log.warning "LAN server mode is enabled. OpenCode listens on 0.0.0.0:${SERVER_PORT}; only map this on trusted networks."
    bashio::log.info "Connect from another computer with: opencode attach http://opencode@<home-assistant-host>:${HOST_PORT}"
else
    bashio::log.info "No host port mapping for ${SERVER_PORT}/tcp; sibling add-ons (OpenChamber) still reach it directly."
    bashio::log.info "Map ${SERVER_PORT}/tcp in the add-on Network settings to connect from outside."
fi

# ==============================================================================
# Optional browser CORS origins
# ------------------------------------------------------------------------------
# opencode serve only accepts browser origins via --cors <origin> (no
# environment variable equivalent). Without it, browser-based clients that
# talk to this server directly (e.g. a web/VS Code UI, as opposed to the
# 'opencode attach' CLI) can be blocked by the browser's CORS policy: simple
# requests like listing providers/models may still get through, while the
# actual chat message/event-stream requests silently get no response. This
# option is empty by default, so 'opencode attach' and other non-browser
# clients are unaffected.
# ==============================================================================
CORS_ORIGINS_COUNT=$(bashio::config 'cors_origins | length' 2>/dev/null || echo "0")
CORS_ARGS=()
if [ "${CORS_ORIGINS_COUNT}" -gt 0 ]; then
    for i in $(seq 0 $((CORS_ORIGINS_COUNT - 1))); do
        CORS_ORIGIN=$(bashio::config "cors_origins[${i}]")
        if [ -n "${CORS_ORIGIN}" ]; then
            CORS_ARGS+=(--cors "${CORS_ORIGIN}")
            bashio::log.info "LAN server: allowing browser origin via CORS: ${CORS_ORIGIN}"
        fi
    done
fi

if [ "${#CORS_ARGS[@]}" -eq 0 ]; then
    bashio::log.info "LAN server: no CORS origins configured. Browser-based clients (e.g. a web/VS Code UI pointed at this server) will be blocked by the browser; only non-browser clients such as 'opencode attach' are supported without this option."
    bashio::log.info "Starting OpenCode LAN server: opencode serve --hostname 0.0.0.0 --port ${SERVER_PORT}"
else
    bashio::log.info "Starting OpenCode LAN server: opencode serve --hostname 0.0.0.0 --port ${SERVER_PORT} --cors <configured origin(s)>"
fi

cd /homeassistant
if HEADLESS_PERMISSION_CONFIG=$(node /opt/ha-mcp-server/headless-permissions.mjs); then
    export OPENCODE_CONFIG_CONTENT="${HEADLESS_PERMISSION_CONFIG}"
    bashio::log.info "LAN server: explicit edit allows are enabled; unmatched headless edit requests are denied."
else
    bashio::log.warning "LAN server: could not prepare the headless permission policy; OpenCode's normal permission handling applies."
fi
exec opencode serve --hostname 0.0.0.0 --port "${SERVER_PORT}" "${CORS_ARGS[@]}"
