#!/command/with-contenv bashio
# ==============================================================================
# OpenCode - Terminal Service (ttyd + tmux via ingress)
# ==============================================================================

# Set home to persistent data directory
export HOME="/data"
export XDG_DATA_HOME="/data/.local/share"
export XDG_CONFIG_HOME="/data/.config"
export NPM_CONFIG_PREFIX="/data/.npm-global"

# Load user-defined environment variables (written by init-opencode)
if [ -f /data/.env_vars ]; then
    source /data/.env_vars
fi

# Load discovered service variables (written by background discovery)
if [ -f /data/.env_vars_discovered ]; then
    source /data/.env_vars_discovered
fi

# Keep the Supervisor token process-only. Tools that expect HA_TOKEN receive it
# from the live environment instead of a persisted /data/.env_vars entry.
if [ -n "${SUPERVISOR_TOKEN:-}" ]; then
    export HA_TOKEN="${SUPERVISOR_TOKEN}"
fi

# Only the certified runtime in this image is on PATH. /data/.npm-global is
# left out on purpose so an OpenCode installed there by an older add-on version
# cannot shadow the build this release was tested against.
export PATH="/usr/local/bin:/usr/bin:/bin:${PATH}"
export OPENCODE_DISABLE_AUTOUPDATE=true

bashio::log.info "=============================================="
bashio::log.info "  OpenCode Terminal (ttyd + ingress)"
bashio::log.info "=============================================="

# ==============================================================================
# Set Node.js memory limit (hardcoded for stability)
# ==============================================================================

export NODE_OPTIONS="--max-old-space-size=512"

# ==============================================================================
# Terminal appearance (fixed in this fork: Breeze theme, 14px, block cursor,
# no blink)
# ==============================================================================

THEME_JSON='{"background":"#232627","foreground":"#fcfcfc","cursor":"#fcfcfc","cursorAccent":"#232627","selectionBackground":"#3daee9","selectionForeground":"#fcfcfc","black":"#232627","red":"#ed1515","green":"#11d116","yellow":"#f67400","blue":"#1d99f3","magenta":"#9b59b6","cyan":"#1abc9c","white":"#fcfcfc","brightBlack":"#7f8c8d","brightRed":"#c0392b","brightGreen":"#1cdc9a","brightYellow":"#fdbc4b","brightBlue":"#3daee9","brightMagenta":"#8e44ad","brightCyan":"#16a085","brightWhite":"#ffffff"}'

bashio::log.info "Starting ttyd on port 8099 (Home Assistant ingress)..."

# ==============================================================================
# Start ttyd with configured options
# Uses tmux to maintain a single persistent session. When a user disconnects
# and reconnects, they reattach to the existing session instead of spawning
# a new OpenCode instance. The -A flag means "attach if session exists,
# otherwise create a new one".
# ==============================================================================

# -I serves the custom index page built in the Dockerfile, which adds
# clipboard support (OSC 52 from OpenCode/tmux -> browser clipboard, Ctrl+V
# paste) and touch scrolling for mobile browsers.
# macOptionClickForcesSelection lets macOS users select text with Option+drag
# while OpenCode has mouse reporting enabled (the Shift+drag override is
# Windows/Linux-only in xterm.js).
# -d 3 sets the libwebsockets log level to ERR|WARN only. ttyd's default is 7
# (ERR|WARN|NOTICE), which logs every accepted HTTP connection at NOTICE — so
# the container health check (curl http://127.0.0.1:8099/ every 30s) produced a
# repeating three-line burst (__lws_lc_tag / HTTP / / __lws_lc_untag) that
# spammed the add-on log ~4300 lines a day. Errors and warnings still surface.
exec ttyd \
    -W \
    -d 3 \
    -p 8099 \
    -I /opt/ttyd/index.html \
    -t fontSize=14 \
    -t fontWeight=normal \
    -t fontWeightBold=bold \
    -t letterSpacing=0 \
    -t lineHeight=1.0 \
    -t cursorBlink=false \
    -t cursorStyle=block \
    -t drawBoldTextInBrightColors=true \
    -t minimumContrastRatio=4.5 \
    -t macOptionClickForcesSelection=true \
    -t scrollback=10000 \
    -t "theme=${THEME_JSON}" \
    tmux new-session -A -s opencode /usr/local/bin/opencode-session.sh
