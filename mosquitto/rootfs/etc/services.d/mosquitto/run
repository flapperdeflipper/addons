#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# bashio enables errexit, errtrace, nounset and pipefail.

readonly OPTIONS=/data/options.json
readonly SYSTEM_USER=/data/system_user.json
readonly CONFIG=/etc/mosquitto.conf
readonly CONFIG_TEMPLATE=/etc/mosquitto.conf.template
readonly CONFIG_OVERRIDE=/data/mosquitto.conf
readonly SCHEMA=/usr/share/create_tables.sql

# Seconds to wait for the MySQL service before giving up.
readonly MYSQL_WAIT=60

################################################################################
## MySQL                                                                      ##
################################################################################

# Credentials go through a defaults file, not -p, so they don't show in ps.
MYSQL_DEFAULTS=

function mysql_defaults() {
    MYSQL_DEFAULTS="$(mktemp)"
    chmod 0600 "${MYSQL_DEFAULTS}"
    {
        echo "[client]"
        echo "user=${MYSQL_USER}"
        echo "password=\"${MYSQL_PASS}\""
        echo "host=${MYSQL_HOST}"
        echo "port=${MYSQL_PORT}"
    } >"${MYSQL_DEFAULTS}"
}

function sql() {
    mysql --defaults-extra-file="${MYSQL_DEFAULTS}" --skip-column-names "$@"
}

function wait_for_mysql() {
    local deadline=$((SECONDS + MYSQL_WAIT))

    until mysqladmin --defaults-extra-file="${MYSQL_DEFAULTS}" --silent ping >/dev/null 2>&1; do
        if ((SECONDS >= deadline)); then
            bashio::exit.nok "MySQL at ${MYSQL_HOST}:${MYSQL_PORT} not reachable after ${MYSQL_WAIT}s"
        fi
        bashio::log.info "Waiting for MySQL at ${MYSQL_HOST}:${MYSQL_PORT}"
        sleep 2
    done
}

function database_exists() {
    local found

    found="$(sql -e "SHOW DATABASES LIKE 'mosquitto'")"
    [[ -n "${found}" ]]
}

function create_database() {
    local admin_hash="${1}"
    local hass_hash="${2}"
    local addons_hash="${3}"

    bashio::log.info "Creating database and schema for mosquitto"
    sql -e 'CREATE DATABASE mosquitto'

    # Hashes are PBKDF2 strings ([A-Za-z0-9$+/=]): safe as sed replacements.
    sed -e "s|%%ADMIN_PASSWORD%%|${admin_hash}|g" \
        -e "s|%%HASS_PASSWORD%%|${hass_hash}|g" \
        -e "s|%%ADDONS_PASSWORD%%|${addons_hash}|g" \
        "${SCHEMA}" \
        | sql mosquitto
}

################################################################################
## Config                                                                     ##
################################################################################

function write_system_users() {
    jq --null-input \
        --arg hass "${1}" \
        --arg addons "${2}" \
        '{homeassistant: {password: $hass}, addons: {password: $addons}}' \
        >"${SYSTEM_USER}"
    chmod 0600 "${SYSTEM_USER}"
}

function tls_listeners() {
    local cafile="${1}"
    local certfile="${2}"
    local keyfile="${3}"
    local require_certificate="${4}"
    local listener

    for listener in "8883 mqtt" "8884 websockets"; do
        echo
        echo "listener ${listener% *}"
        echo "protocol ${listener#* }"
        echo "cafile /ssl/${cafile}"
        echo "certfile /ssl/${certfile}"
        echo "keyfile /ssl/${keyfile}"
        echo "require_certificate ${require_certificate}"
    done
}

function render_config() {
    local anonymous certfile keyfile cafile require_certificate logging folder
    local config

    anonymous="$(jq --raw-output '.anonymous // false' "${OPTIONS}")"
    certfile="$(jq --raw-output '.certfile // empty' "${OPTIONS}")"
    keyfile="$(jq --raw-output '.keyfile // empty' "${OPTIONS}")"
    cafile="$(jq --raw-output --arg cert "${certfile}" '.cafile // $cert' "${OPTIONS}")"
    require_certificate="$(jq --raw-output '.require_certificate // false' "${OPTIONS}")"
    logging="$(bashio::info 'hassio.info.logging' '.logging')"

    bashio::log.info "Generating ${CONFIG}"

    # Render from the template on every start so a restart never sees an
    # already-substituted file. Quoted replacements keep & and \ literal.
    config="$(<"${CONFIG_TEMPLATE}")"
    config="${config//%%ANONYMOUS%%/"${anonymous}"}"
    config="${config//%%AUTH_QUIET_LOGS%%/"${logging}"}"
    config="${config//%%MYSQL_USER%%/"${MYSQL_USER}"}"
    config="${config//%%MYSQL_PASS%%/"${MYSQL_PASS}"}"
    config="${config//%%MYSQL_HOST%%/"${MYSQL_HOST}"}"
    config="${config//%%MYSQL_PORT%%/"${MYSQL_PORT}"}"

    if [[ "$(jq --raw-output '.customize.active // false' "${OPTIONS}")" == "true" ]]; then
        folder="$(jq --raw-output '.customize.folder // "mosquitto"' "${OPTIONS}")"
        config="${config//\#include_dir \/share\/mosquitto/"include_dir /share/${folder}"}"
    fi

    if [[ -e "/ssl/${cafile}" && -e "/ssl/${certfile}" && -e "/ssl/${keyfile}" ]]; then
        bashio::log.info "Enabling TLS listeners on 8883 and 8884"
        config+="$(tls_listeners "${cafile}" "${certfile}" "${keyfile}" "${require_certificate}")"
    else
        bashio::log.warning "TLS not enabled: certificate files not found in /ssl"
    fi

    umask 077
    echo "${config}" >"${CONFIG}"
}

################################################################################
## Supervisor                                                                 ##
################################################################################

function mqtt_service_config() {
    jq --null-input \
        --arg host "$(hostname)" \
        --arg username "${1}" \
        --arg password "${2}" \
        '{host: $host, port: 1883, ssl: false, protocol: "3.1.1", username: $username, password: $password}'
}

function mqtt_service_host() {
    bashio::services.available mqtt && bashio::services mqtt host || true
}

function register_services() {
    local host

    host="$(mqtt_service_host)"
    if [[ -n "${host}" && "${host}" != "$(hostname)" ]]; then
        bashio::log.warning "Another MQTT service is already registered (${host})"
        return 0
    fi

    bashio::log.info "Registering the mqtt service and Home Assistant discovery"
    bashio::services.publish mqtt "$(mqtt_service_config addons "${ADDONS_PASSWORD}")" >/dev/null \
        || bashio::log.error "Can't register the mqtt service"
    bashio::discovery mqtt "$(mqtt_service_config homeassistant "${HASS_PASSWORD}")" >/dev/null \
        || bashio::log.error "Can't register Home Assistant mqtt discovery"
}

function unregister_services() {
    if [[ "$(mqtt_service_host)" == "$(hostname)" ]]; then
        bashio::services.delete mqtt >/dev/null \
            || bashio::log.warning "Can't unregister the mqtt service"
    fi
}

################################################################################
## Main                                                                       ##
################################################################################

bashio::log.info "Reading MySQL service credentials"
MYSQL_USER="$(bashio::services mysql username)"
MYSQL_PASS="$(bashio::services mysql password)"
MYSQL_HOST="$(bashio::services mysql host)"
MYSQL_PORT="$(bashio::services mysql port)"

# The database is the source of truth for every user. The add-on only seeds
# admin, homeassistant and addons when it creates the database.
if [[ -e "${SYSTEM_USER}" ]]; then
    HASS_PASSWORD="$(jq --raw-output '.homeassistant.password' "${SYSTEM_USER}")"
    ADDONS_PASSWORD="$(jq --raw-output '.addons.password' "${SYSTEM_USER}")"
else
    bashio::log.info "Generating system user passwords"
    HASS_PASSWORD="$(pwgen -s 64 1)"
    ADDONS_PASSWORD="$(pwgen -s 64 1)"
fi
write_system_users "${HASS_PASSWORD}" "${ADDONS_PASSWORD}"

mysql_defaults
trap 'rm -f "${MYSQL_DEFAULTS}"' EXIT
wait_for_mysql

if ! database_exists; then
    ADMIN_PASSWORD="$(jq --raw-output '.admin_password' "${OPTIONS}")"
    if [[ "${ADMIN_PASSWORD}" == '!secret '* ]]; then
        bashio::exit.nok "admin_password is an unresolved !secret reference (key missing in secrets.yaml) - refusing to configure the broker with it"
    fi
    create_database \
        "$(pw -p "${ADMIN_PASSWORD}")" \
        "$(pw -p "${HASS_PASSWORD}")" \
        "$(pw -p "${ADDONS_PASSWORD}")"
fi
rm -f "${MYSQL_DEFAULTS}"

if [[ -f "${CONFIG_OVERRIDE}" ]]; then
    bashio::log.info "Using ${CONFIG_OVERRIDE} instead of the generated config"
    cp "${CONFIG_OVERRIDE}" "${CONFIG}"
else
    render_config
fi

register_services

bashio::log.info "Starting Mosquitto"
mosquitto -c "${CONFIG}" &
MOSQUITTO_PID=$!

function stop_mosquitto() {
    bashio::log.info "Shutting down Mosquitto"
    kill -TERM "${MOSQUITTO_PID}" 2>/dev/null || true
    unregister_services
    wait "${MOSQUITTO_PID}" || true
}
trap stop_mosquitto SIGTERM SIGHUP

wait "${MOSQUITTO_PID}"
