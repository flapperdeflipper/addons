#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# OpenCode TUI: ttyd on the Ingress port, tmux around the OpenCode client so a
# session survives a closed tab or a second browser. The client attaches to
# the server in `server_url` with its basic-auth password; nothing runs here
# but the interface.
# ==============================================================================

export HOME="/data"
export XDG_DATA_HOME="/data/.local/share"
export XDG_CONFIG_HOME="/data/.config"
export XDG_STATE_HOME="/data/.local/state"
export PATH="/usr/local/bin:/usr/bin:/bin:${PATH}"
export OPENCODE_DISABLE_AUTOUPDATE=true
mkdir -p "${XDG_DATA_HOME}" "${XDG_CONFIG_HOME}" "${XDG_STATE_HOME}"

SERVER_URL=$(bashio::config 'server_url' 2>/dev/null || echo "")
SERVER_PASSWORD=$(bashio::config 'server_password' 2>/dev/null || echo "")
DIRECTORY=$(bashio::config 'directory' 2>/dev/null || echo "/workspace")
FONT_SIZE=$(bashio::config 'font_size' 2>/dev/null || echo "14")

case "${SERVER_PASSWORD}" in
    '!secret '*)
        bashio::log.error "server_password is an unresolved !secret reference (key missing in secrets.yaml): fix the key, then restart."
        exec sleep infinity
        ;;
esac
if ! bashio::var.has_value "${SERVER_URL}" || ! bashio::var.has_value "${SERVER_PASSWORD}"; then
    bashio::log.error "Set 'server_url' and 'server_password' in the Configuration tab, then restart."
    exec sleep infinity
fi

# Read by the session script (and the OpenCode client) from the environment
# ttyd and tmux pass down; never written to disk or put on a command line.
export OPENCODE_TUI_SERVER="${SERVER_URL}"
export OPENCODE_TUI_DIRECTORY="${DIRECTORY}"
export OPENCODE_PASSWORD="${SERVER_PASSWORD}"

bashio::log.info "OpenCode TUI: attaching to ${SERVER_URL} (directory ${DIRECTORY})"

THEME_JSON='{"background":"#232627","foreground":"#fcfcfc","cursor":"#fcfcfc","cursorAccent":"#232627","selectionBackground":"#3daee9","selectionForeground":"#fcfcfc","black":"#232627","red":"#ed1515","green":"#11d116","yellow":"#f67400","blue":"#1d99f3","magenta":"#9b59b6","cyan":"#1abc9c","white":"#fcfcfc","brightBlack":"#7f8c8d","brightRed":"#c0392b","brightGreen":"#1cdc9a","brightYellow":"#fdbc4b","brightBlue":"#3daee9","brightMagenta":"#8e44ad","brightCyan":"#16a085","brightWhite":"#ffffff"}'

exec ttyd \
    -W \
    -d 3 \
    -p 8099 \
    -I /opt/ttyd/index.html \
    -t "fontSize=${FONT_SIZE}" \
    -t cursorBlink=false \
    -t cursorStyle=block \
    -t drawBoldTextInBrightColors=true \
    -t macOptionClickForcesSelection=true \
    -t scrollback=10000 \
    -t "theme=${THEME_JSON}" \
    tmux new-session -A -s opencode /usr/local/bin/opencode-tui-session
