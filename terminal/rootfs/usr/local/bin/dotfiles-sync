#!/usr/bin/env bash
# ==============================================================================
# dotfiles-sync - clone or update the toolset and dotfiles repositories,
# create the custom aliases file, stow the profile into /data, and install
# the python dependencies from the dotfiles pyproject.toml.
#
# Runs from init-terminal at every add-on start (--init) and can be run
# interactively inside the terminal at any time.
#
# Every step logs and continues: a partially synced environment still beats
# no terminal at all. The exit status is non-zero when something failed, so
# the init service can surface a warning.
# ==============================================================================

set -uo pipefail

export HOME="${HOME:-/data}"
export PATH="/usr/local/bin:/usr/bin:/bin:${PATH}"

# Never hang on credentials or host-key prompts: this runs non-interactively
# during add-on startup.
export GIT_TERMINAL_PROMPT=0
export GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=accept-new"

FAILED=0

log()  { echo "[INFO ] ${*}"; }
warn() { echo "[WARN ] ${*}" >&2; }
err()  { echo "[ERROR] ${*}" >&2; }

usage() {
    cat <<EOF

    Sync the dotfiles and toolset into the /data home directory

    ${0} [--init] [--no-python]

    Options:
      --init        Add-on boot mode: python dependency installation is
                    detached to the background so the terminal starts fast
      --no-python   Skip the python virtualenv entirely (also skipped
                    when the install_python_deps option is false)
      -h, --help    Show this menu

EOF

    exit 0
}

#
# Read an option from /data/options.json with a fallback default
#
option() {
    local key="${1}" default="${2}"
    local value
    # 'key // empty' would swallow an explicit false (jq falsy gotcha), so
    # distinguish null (missing) from real values instead.
    value=$(jq -r "${key} | if . == null then \"\" else tostring end" /data/options.json 2>/dev/null)
    echo "${value:-${default}}"
}

# ==============================================================================
# git plumbing
# ==============================================================================

#
# Can gh provide GitHub credentials? True when GH_TOKEN is set (env_vars
# option) or after an interactive 'gh auth login' in the terminal.
#
gh_authenticated() {
    command -v gh >/dev/null 2>&1 || return 1
    gh auth status >/dev/null 2>&1
}

#
# Wrap git so GitHub HTTPS operations pick up gh credentials when available.
# Public repositories clone fine without them.
#
git_git() {
    if gh_authenticated; then
        git -c credential.helper='!gh auth git-credential' "$@"
    else
        git "$@"
    fi
}

#
# Rewrite GitHub SSH URLs to HTTPS so the gh credential helper applies.
# Other URLs pass through unchanged.
#
to_https() {
    local url="${1}"
    case "${url}" in
        git@github.com:*)
            echo "https://github.com/${url#git@github.com:}"
            ;;
        ssh://git@github.com/*)
            echo "https://github.com/${url#ssh://git@github.com/}"
            ;;
        *)
            echo "${url}"
            ;;
    esac
}

clone_repo() {
    local repo="${1}" dest="${2}" url

    url="${repo}"
    if gh_authenticated; then
        url="$(to_https "${repo}")"
    fi

    log "Cloning ${repo} into ${dest}"
    if ! git_git clone "${url}" "${dest}"; then
        err "Failed to clone ${repo}"
        return 1
    fi
}

update_repo() {
    local dest="${1}"

    if ! git -C "${dest}" diff --quiet 2>/dev/null \
        || ! git -C "${dest}" diff --cached --quiet 2>/dev/null; then
        warn "Repository ${dest} has local changes - skipping pull"
        return 0
    fi

    log "Updating ${dest}"
    if ! git_git -C "${dest}" pull --ff-only --prune; then
        warn "Failed to update ${dest} - keeping the current checkout"
    fi
}

ensure_repo() {
    local repo="${1}" dest="${2}"

    if [ -d "${dest}/.git" ]; then
        update_repo "${dest}"
    else
        if ! clone_repo "${repo}" "${dest}"; then
            return 1
        fi
    fi
}

# ==============================================================================
# Steps
# ==============================================================================

sync_toolset() {
    local repo
    repo=$(option '.toolset_repo' 'https://github.com/flapperdeflipper/toolset.git')

    ensure_repo "${repo}" "${HOME}/.toolset" || return 1

    # The toolset binaries and libraries are used directly from the checkout
    chmod +x "${HOME}/.toolset/bin/"* 2>/dev/null || true
}

sync_dotfiles() {
    local repo
    repo=$(option '.dotfiles_repo' 'git@github.com:flapperdeflipper/dotfiles.git')

    if ! ensure_repo "${repo}" "${HOME}/.dotfiles"; then
        err "Could not fetch the dotfiles repository (${repo})."
        err "If it is private, authenticate in one of these ways and retry with 'dotfiles-sync':"
        err "  1. gh auth login          interactive, once (stored under ${HOME}/.config/gh)"
        err "  2. set GH_TOKEN in the add-on env_vars option and restart the add-on"
        return 1
    fi
}

install_custom_aliases() {
    local target="${HOME}/.custom_aliases"
    local template="${HOME}/.dotfiles/.ansible/templates/custom_aliases.tpl"

    if [ -f "${target}" ]; then
        return 0
    fi

    if [ ! -f "${template}" ]; then
        warn "No custom_aliases template in the dotfiles - skipping"
        return 0
    fi

    log "Creating ${target}"
    if ! install -m 600 "${template}" "${target}"; then
        warn "Failed to create ${target}"
    fi
}

stow_profile() {
    local update="${HOME}/.dotfiles/profile/bin/update-profile"

    if [ ! -x "${update}" ]; then
        warn "update-profile not found at ${update} - skipping stow"
        return 1
    fi

    if ! command -v stow >/dev/null 2>&1; then
        warn "stow is not installed - skipping"
        return 1
    fi

    # update-profile sources the toolset ('source toolset'), so both bin
    # directories must be on PATH before it runs.
    export PATH="${HOME}/.toolset/bin:${HOME}/.dotfiles/profile/bin:${PATH}"

    log "Stowing the dotfiles profile into ${HOME}"
    if ! (cd "${HOME}/.dotfiles" && "${update}" --apply); then
        err "Failed to stow the dotfiles profile"
        return 1
    fi
}

install_python_deps() {
    local mode="${1}"   # foreground | background
    local venv="${HOME}/.venv"

    if [ ! -d "${HOME}/.dotfiles" ]; then
        warn "No dotfiles checkout - skipping python dependencies"
        return 0
    fi

    if [ "${mode}" = "background" ]; then
        mkdir -p "${HOME}/.cache"
        log "Installing python dependencies in the background (log: ${HOME}/.cache/dotfiles-venv.log)"
        setsid /usr/local/bin/dotfiles-sync --no-python-run </dev/null \
            >"${HOME}/.cache/dotfiles-venv.log" 2>&1 &
        return 0
    fi

    if [ ! -x "${venv}/bin/pip" ]; then
        log "Creating virtualenv ${venv}"
        if ! python3 -m venv "${venv}"; then
            err "Failed to create virtualenv ${venv}"
            return 1
        fi
    fi

    log "Installing python dependencies from the dotfiles (this can take a few minutes)"
    if ! "${venv}/bin/pip" install --quiet --upgrade pip; then
        warn "Failed to upgrade pip in ${venv}"
    fi
    if ! "${venv}/bin/pip" install --upgrade "${HOME}/.dotfiles"; then
        err "Failed to install python dependencies"
        return 1
    fi
    log "Python dependencies installed in ${venv}"
}

# ==============================================================================
# Main
# ==============================================================================

INIT_MODE=false
# Default honors the install_python_deps add-on option; --no-python still
# forces it off for this run.
RUN_PYTHON="$(option '.install_python_deps' 'true')"
[ "${RUN_PYTHON}" = "true" ] || RUN_PYTHON=false

while [ "${1:-}" != "" ]; do
    case "${1}" in
        --init)
            INIT_MODE=true
            ;;
        --no-python)
            RUN_PYTHON=false
            ;;
        --no-python-run)
            # internal: recursion marker used by the background install
            RUN_PYTHON=run
            ;;
        -h | --help)
            usage
            ;;
        *)
            usage
            ;;
    esac
    shift || true
done

# Background child (started by install_python_deps in background mode):
# run only the venv install, nothing else, so it never races the parent sync.
if [ "${RUN_PYTHON}" = "run" ]; then
    install_python_deps foreground || exit 1
    exit 0
fi

sync_toolset || FAILED=1
sync_dotfiles || FAILED=1

if [ -d "${HOME}/.dotfiles" ]; then
    install_custom_aliases
    stow_profile || FAILED=1
fi

if [ "${RUN_PYTHON}" = "true" ]; then
    if [ "${INIT_MODE}" = "true" ]; then
        install_python_deps background
    else
        install_python_deps foreground || FAILED=1
    fi
fi

if [ "${FAILED}" -ne 0 ]; then
    err "Dotfiles sync completed with problems"
    exit 1
fi

log "Dotfiles sync complete"
exit 0
